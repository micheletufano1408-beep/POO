<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.aggiungiCampagnaMarketing">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="7" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="15" vgap="15">
    <margin top="25" left="25" bottom="25" right="25"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none" title="Registra Nuova Campagna Marketing"/>
    <children>
      <component id="lbl1" class="javax.swing.JLabel">
